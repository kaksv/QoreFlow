{
  "name": "qoreflow",
  "version": "0.1.0",
  "private": true,
  "description": "QoreFlow — quantum-secure continuous payment streaming on QoreChain",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "compile": "hardhat compile",
    "test": "npm run test:unit && npm run test:invariants",
    "test:unit": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat test test/QoreFlow.test.ts test/PQCAuthorization.test.ts",
    "test:invariants": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat test test/invariants/*.ts",
    "test:testnet": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat test test/testnet/*.ts --network qorechainTestnet",
    "coverage": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat coverage",
    "deploy:testnet": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deploy.ts --network qorechainTestnet",
    "verify:deployment": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/verify-deployment.ts --network qorechainTestnet"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@openzeppelin/contracts": "5.0.2",
    "@qorechain/pqc": "0.2.3",
    "@tanstack/react-query": "5.62.7",
    "bech32": "1.1.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "ethers": "6.14.0",
    "lucide-react": "0.468.0",
    "next": "15.5.29",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.2",
    "sonner": "1.7.1",
    "tailwind-merge": "2.5.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@types/mocha": "10.0.10",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "dotenv": "^16.4.7",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.29",
    "hardhat": "^2.28.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "ts-node": "10.9.2",
    "typescript": "5.7.2"
  }
}
