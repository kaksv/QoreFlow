# ---------------------------------------------------------------------------
# QoreFlow environment configuration
# Copy to .env.local for the frontend and/or .env for Hardhat scripts.
# NEVER commit a filled-in copy. NEVER put a private key in a NEXT_PUBLIC_ var.
# ---------------------------------------------------------------------------

# --- Public frontend configuration (safe to expose) -------------------------
NEXT_PUBLIC_CHAIN_ID=9800
NEXT_PUBLIC_QORECHAIN_RPC=https://evm-testnet.qore.host
NEXT_PUBLIC_QORECHAIN_REST=https://api-testnet.qore.host
NEXT_PUBLIC_EXPLORER_URL=https://explore.qore.network
# Set after deployment (scripts/deploy.ts prints it).
NEXT_PUBLIC_CONTRACT_ADDRESS=
# Optional: first block that contains QoreFlow events. Keeps log queries small.
NEXT_PUBLIC_DEPLOY_BLOCK=

# --- Server-side / scripts only --------------------------------------------
# Read-only RPC used by Hardhat scripts and the testnet integration suite.
QORECHAIN_RPC_URL=https://evm-testnet.qore.host
QORECHAIN_REST_URL=https://api-testnet.qore.host

# Throwaway testnet key ONLY. Funded from the faucet, never holds real value.
# Leave empty to compile, test and build the frontend without a key.
DEPLOYER_PRIVATE_KEY=

# Required for the real-testnet PQC integration suite (test/testnet/*).
# This is a throwaway account with a registered ML-DSA-87 key.
TESTNET_SENDER_PRIVATE_KEY=
# The ML-DSA-87 secret key for the same account, hex-encoded, for test signing.
# Generate with the QoreChain tooling; never use a key that holds real funds.
TESTNET_PQC_SECRET_KEY_HEX=
# Address of an already-deployed QoreFlow used by the integration suite.
TESTNET_QOREFLOW_ADDRESS=
